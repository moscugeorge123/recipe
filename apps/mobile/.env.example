# Public API origin used by the HTTP client, including the `/api/v1` prefix.
# Values prefixed with EXPO_PUBLIC_ are inlined into the JavaScript bundle
# at build time. Anyone who downloads the app can read them.
#
# Safe to put here:
#   - public API base URLs
#   - feature flags that are not secrets
#   - publishable third-party keys that are designed to be public
#
# Never put in EXPO_PUBLIC_* (or anywhere else in this client app):
#   - API secrets, private keys, or signing credentials
#   - database passwords
#   - OpenAI keys (those belong on the API)
#   - admin tokens
#   - anything that grants privileged access if leaked
#
# The client sends Authorization: Bearer <Firebase ID token> when someone is
# signed in. This variable stays a public origin only.
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# Local API:        http://localhost:3000/api/v1
# Android emulator: http://10.0.2.2:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Firebase public client config. These values are inlined into the app binary.
# They identify the Firebase project; they are not secrets.
#
# Never put the Firebase Admin SDK private key, a service-account JSON file,
# or any server credential in EXPO_PUBLIC_* or anywhere else in this client.
#
# Use a dev Firebase project locally and a separate prod project for release
# builds. In each project's Firebase console, add the authorized domains you
# actually use (localhost for dev, the production domain for prod) and register
# the matching Google and Facebook OAuth client ids.
#
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_FIREBASE_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_FIREBASE_FACEBOOK_APP_ID=
# EXPO_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN=
# EXPO_PUBLIC_FIREBASE_APP_CHECK_RECAPTCHA_SITE_KEY=
