# Public API origin used by the HTTP client, including the `/api/v1` prefix.
# Values prefixed with EXPO_PUBLIC_ are inlined into the JavaScript bundle
# at build time. Anyone who downloads the app can read them.
#
# Safe to put here:
#   - public API base URLs
#   - feature flags that are not secrets
#   - publishable third-party keys that are designed to be public
#
# Never put in EXPO_PUBLIC_* (or anywhere else in this client app):
#   - API secrets, private keys, or signing credentials
#   - database passwords
#   - OpenAI keys (those belong on the API)
#   - admin tokens
#   - anything that grants privileged access if leaked
#
# The API currently uses a singleton implicit profile (no login). Point this
# URL at your local API. When authentication ships, the client will send an
# Authorization header; this variable stays a public origin only.
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# Local API:        http://localhost:3000/api/v1
# Android emulator: http://10.0.2.2:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# --- Firebase Authentication (email/password, Google, Facebook) -------------
# Firebase web app config: Firebase console > Project settings > General >
# Your apps > Web app (</>) > firebaseConfig. These are PUBLIC identifiers, not
# secrets. They end up in the APK, exactly like EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Firebase console > Authentication > Sign-in method > Google > Web SDK
# configuration > Web client ID. Public.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<...>.apps.googleusercontent.com

# Read by app.config.ts at BUILD time (expo prebuild / eas build), not by the
# JavaScript bundle. Meta developer console > App settings > Basic (App ID) and
# Advanced > Security > Client token. Both are embedded in the APK, so they are
# public too. NEVER put the Facebook App Secret here; it only belongs in the
# Firebase console.
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=
