{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "Recipe extraction API — Fastify + TypeScript + PostgreSQL + BullMQ worker",
  "nx": {
    "tags": [
      "type:app",
      "platform:node"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "prebuild": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "postinstall": "prisma generate",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker/index.js",
    "import:smoke": "tsx --env-file-if-exists=.env src/scripts/import-smoke.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@recipe/contracts": "*",
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.70.0",
    "bullmq": "^6.1.2",
    "fastify": "5.12.1",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "^6.0.0",
    "openai": "^7.5.0",
    "openapi-types": "12.1.3",
    "pino": "10.3.1",
    "pino-roll": "3.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prisma": "^6.19.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
