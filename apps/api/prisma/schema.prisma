generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums -------------------------------------------------------------------

enum SourceType {
  INSTAGRAM
  YOUTUBE
  FACEBOOK
  TIKTOK
  GENERIC_WEB
}

enum JobStatus {
  QUEUED
  ACQUIRING_CONTENT
  CONTENT_ACQUIRED
  PROCESSING_MEDIA
  TRANSCRIBING
  ANALYZING_FRAMES
  RUNNING_OCR
  EXTRACTING_RECIPE
  NORMALIZING_RECIPE
  VALIDATING_RECIPE
  COMPLETED
  FAILED
  CANCELLED
}

enum PipelineStage {
  ACQUIRING_CONTENT
  PROCESSING_MEDIA
  TRANSCRIBING
  ANALYZING_FRAMES
  RUNNING_OCR
  EXTRACTING_RECIPE
  NORMALIZING_RECIPE
  VALIDATING_RECIPE
}

enum StageStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum AssetType {
  VIDEO
  AUDIO
  IMAGE
  THUMBNAIL
  FRAME
}

enum EvidenceType {
  CAPTION
  DESCRIPTION
  TRANSCRIPT
  OCR
  VISION
  METADATA
}

enum EvidenceSource {
  CAPTION
  TRANSCRIPT
  OCR
  VISION
  METADATA
  LLM
}

enum CookSessionStatus {
  IN_PROGRESS
  COMPLETED
  STOPPED
}

enum RevisionSource {
  IMPORT
  USER_EDIT
  AI_ASSISTED
  RESTORE
  MIGRATION
}

enum RecipeReviewState {
  NEEDS_REVIEW
  READY
}

enum NutritionStatus {
  NOT_REQUESTED
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum PantryClassificationStatus {
  UNCLASSIFIED
  PENDING
  CLASSIFIED
  NEEDS_REVIEW
  FAILED
}

enum PantryStorageLocation {
  PANTRY
  FRIDGE
  FREEZER
  OTHER
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MealEntryKind {
  RECIPE
  NOTE
}

// --- Profiles & ownership ----------------------------------------------------

model User {
  id          String   @id @default(uuid()) @db.Uuid
  profileKey  String?  @unique
  authSubject String?  @unique
  email       String?  @unique
  displayName String?
  preferences Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipes           UserRecipe[]
  categories        Category[]
  revisions         RecipeRevision[]
  cookSessions      CookSession[]
  collections       Collection[]
  pantryItems       PantryItem[]
  shoppingListItems ShoppingListItem[]
  mealPlanEntries   MealPlanEntry[]
  aiUsage           AIUsage[]

  @@map("users")
}

model UserRecipe {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  recipeId    String            @db.Uuid
  reviewState RecipeReviewState @default(NEEDS_REVIEW)
  rating              Int?
  isFavorite          Boolean           @default(false)
  completedCookCount  Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe            Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  categoryLinks     RecipeCategory[]
  revisions         RecipeRevision[]
  notes             RecipeNote[]
  collectionEntries CollectionRecipe[]

  @@unique([userId, recipeId])
  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, reviewState, updatedAt])
  @@index([userId, isFavorite, updatedAt])
  @@index([userId, rating])
  @@index([userId, createdAt, id], map: "user_recipes_latest_idx")
  @@index([userId, isFavorite(sort: Desc), completedCookCount(sort: Desc), updatedAt(sort: Desc), id], map: "user_recipes_engagement_idx")
  @@map("user_recipes")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  slug      String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipes RecipeCategory[]

  @@unique([userId, slug])
  @@unique([id, userId])
  @@index([userId, sortOrder])
  @@map("categories")
}

model RecipeCategory {
  userRecipeId String   @db.Uuid
  categoryId   String   @db.Uuid
  userId       String   @db.Uuid
  createdAt    DateTime @default(now())

  userRecipe UserRecipe @relation(fields: [userRecipeId, userId], references: [id, userId], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Cascade)

  @@id([userRecipeId, categoryId])
  @@index([userId, categoryId])
  @@map("recipe_categories")
}

// --- Source & jobs -----------------------------------------------------------

model RecipeSource {
  id            String     @id @default(uuid()) @db.Uuid
  sourceType    SourceType
  originalUrl   String
  normalizedUrl String
  urlHash       String     @unique
  metadata      Json       @default("{}")
  createdAt     DateTime   @default(now())

  jobs   ExtractionJob[]
  recipe Recipe?

  @@index([sourceType, createdAt])
  @@map("recipe_sources")
}

model ExtractionJob {
  id             String    @id @default(uuid()) @db.Uuid
  recipeSourceId String    @db.Uuid
  recipeId       String?   @unique @db.Uuid
  status         JobStatus @default(QUEUED)
  progress       Int       @default(0)
  currentStage   String?
  sourceLanguage String?
  outputLanguage String    @default("en")
  options        Json      @default("{}")
  error          Json?
  retryCount     Int       @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  recipeSource RecipeSource         @relation(fields: [recipeSourceId], references: [id], onDelete: Cascade)
  recipe       Recipe?              @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  stages       ExtractionStage[]
  mediaAssets  MediaAsset[]
  evidence     ExtractionEvidence[]
  aiUsage      AIUsage[]

  @@index([status])
  @@index([createdAt])
  @@map("extraction_jobs")
}

model ExtractionStage {
  id          String        @id @default(uuid()) @db.Uuid
  jobId       String        @db.Uuid
  stage       PipelineStage
  status      StageStatus   @default(PENDING)
  progress    Int           @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  error       Json?
  attempt     Int           @default(1)

  job ExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("extraction_stages")
}

// --- Recipes -----------------------------------------------------------------

model Recipe {
  id               String   @id @default(uuid()) @db.Uuid
  title            String
  description      String?
  servings         Int?
  prepTimeMinutes  Int?
  cookTimeMinutes  Int?
  totalTimeMinutes Int?
  calories         Int?
  cuisine          String?
  /// Macro breakdown, e.g. { proteinGrams, carbsGrams, fatGrams }
  nutrition        Json?
  sourceLanguage   String?
  confidence       Float    @default(0)
  warnings         Json     @default("[]")
  promptVersion    String?
  rawExtraction    Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recipeSourceId String               @unique @db.Uuid
  recipeSource   RecipeSource         @relation(fields: [recipeSourceId], references: [id], onDelete: Cascade)
  job            ExtractionJob?
  ingredients    RecipeIngredient[]
  steps          RecipeStep[]
  evidence       ExtractionEvidence[]
  cookSessions   CookSession[]
  users          UserRecipe[]

  @@index([createdAt])
  @@map("recipes")
}

model CookSession {
  id                   String            @id @default(uuid()) @db.Uuid
  userId               String            @default("00000000-0000-4000-8000-000000000001") @db.Uuid
  recipeId             String            @db.Uuid
  status               CookSessionStatus @default(IN_PROGRESS)
  currentStepIndex     Int               @default(0)
  currentStepEnteredAt DateTime          @default(now())
  startedAt            DateTime          @default(now())
  finishedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe                @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  stepStats CookSessionStepStat[]
  notes     RecipeNote[]

  @@index([status, updatedAt])
  @@index([userId, updatedAt])
  @@index([recipeId])
  @@index([userId, recipeId, status], map: "cook_sessions_userId_recipeId_status_idx")
  @@map("cook_sessions")
}

model CookSessionStepStat {
  id             String   @id @default(uuid()) @db.Uuid
  sessionId      String   @db.Uuid
  stepIndex      Int
  visitCount     Int      @default(0)
  durationMs     Int      @default(0)
  firstEnteredAt DateTime @default(now())
  lastEnteredAt  DateTime @default(now())

  session CookSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, stepIndex])
  @@index([sessionId])
  @@map("cook_session_step_stats")
}

model RecipeIngredient {
  id            String   @id @default(uuid()) @db.Uuid
  recipeId      String   @db.Uuid
  name          String
  canonicalName String?
  quantity      Decimal? @db.Decimal(10, 3)
  unit          String?
  preparation   String?
  optional      Boolean  @default(false)
  emoji         String   @default("🥣")
  colorToken    String   @default("peach")
  /// Grocery grouping: Produce | Meat | Dairy | Pantry | Spices | Frozen
  category      String   @default("Pantry")
  confidence    Float    @default(0)
  provenance    Json     @default("{}")
  warnings      Json     @default("[]")
  sortOrder     Int      @default(0)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([canonicalName])
  @@map("recipe_ingredients")
}

model RecipeStep {
  id              String  @id @default(uuid()) @db.Uuid
  recipeId        String  @db.Uuid
  stepOrder       Int
  instruction     String
  durationMinutes Int?
  temperature     String?
  /// Cooking stage: PREP | COOK | FINISH | SERVE
  stage           String  @default("COOK")
  confidence      Float   @default(0)
  provenance      Json    @default("{}")
  warnings        Json    @default("[]")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("recipe_steps")
}

model RecipeRevision {
  id               String         @id @default(uuid()) @db.Uuid
  userRecipeId     String         @db.Uuid
  authorUserId     String?        @db.Uuid
  revisionNumber   Int
  source           RevisionSource
  title            String
  description      String?
  servings         Int?
  prepTimeMinutes  Int?
  cookTimeMinutes  Int?
  totalTimeMinutes Int?
  calories         Int?
  cuisine          String?
  nutrition        Json?
  sourceLanguage   String?
  confidence       Float          @default(0)
  warnings         Json           @default("[]")
  promptVersion    String?
  rawExtraction    Json?
  createdAt        DateTime       @default(now())

  userRecipe         UserRecipe                 @relation(fields: [userRecipeId], references: [id], onDelete: Cascade)
  author             User?                      @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  ingredients        RecipeRevisionIngredient[]
  steps              RecipeRevisionStep[]
  categories         RecipeRevisionCategory[]
  nutritionSnapshots NutritionSnapshot[]
  aiUsage            AIUsage[]

  @@unique([userRecipeId, revisionNumber])
  @@index([userRecipeId, createdAt])
  @@index([authorUserId])
  @@map("recipe_revisions")
}

model RecipeRevisionIngredient {
  id            String   @id @default(uuid()) @db.Uuid
  revisionId    String   @db.Uuid
  sourceId      String?  @db.Uuid
  name          String
  canonicalName String?
  quantity      Decimal? @db.Decimal(10, 3)
  unit          String?
  preparation   String?
  optional      Boolean  @default(false)
  emoji         String   @default("🥣")
  colorToken    String   @default("peach")
  category      String   @default("Pantry")
  confidence    Float    @default(0)
  provenance    Json     @default("{}")
  warnings      Json     @default("[]")
  sortOrder     Int      @default(0)

  revision    RecipeRevision       @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  foodMatches NutritionFoodMatch[]

  @@unique([revisionId, sourceId])
  @@index([revisionId, sortOrder])
  @@index([canonicalName])
  @@map("recipe_revision_ingredients")
}

model RecipeRevisionCategory {
  id         String   @id @default(uuid()) @db.Uuid
  revisionId String   @db.Uuid
  categoryId String?  @db.Uuid
  slug       String
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  revision RecipeRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, slug])
  @@index([revisionId, sortOrder])
  @@map("recipe_revision_categories")
}

model RecipeRevisionStep {
  id              String  @id @default(uuid()) @db.Uuid
  revisionId      String  @db.Uuid
  sourceId        String? @db.Uuid
  stepOrder       Int
  instruction     String
  durationMinutes Int?
  temperature     String?
  stage           String  @default("COOK")
  confidence      Float   @default(0)
  provenance      Json    @default("{}")
  warnings        Json    @default("[]")

  revision RecipeRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, stepOrder])
  @@unique([revisionId, sourceId])
  @@index([revisionId])
  @@map("recipe_revision_steps")
}

model RecipeNote {
  id            String   @id @default(uuid()) @db.Uuid
  userRecipeId  String   @db.Uuid
  cookSessionId String?  @db.Uuid
  body          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userRecipe  UserRecipe   @relation(fields: [userRecipeId], references: [id], onDelete: Cascade)
  cookSession CookSession? @relation(fields: [cookSessionId], references: [id], onDelete: SetNull)

  @@index([userRecipeId, updatedAt])
  @@index([cookSessionId])
  @@map("recipe_notes")
}

model Collection {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipes CollectionRecipe[]

  @@unique([userId, name])
  @@index([userId, updatedAt])
  @@map("collections")
}

model CollectionRecipe {
  collectionId String   @db.Uuid
  userRecipeId String   @db.Uuid
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  userRecipe UserRecipe @relation(fields: [userRecipeId], references: [id], onDelete: Cascade)

  @@id([collectionId, userRecipeId])
  @@index([userRecipeId])
  @@map("collection_recipes")
}

model PantryItem {
  id                   String                     @id @default(uuid()) @db.Uuid
  userId               String                     @db.Uuid
  name                 String
  canonicalName        String?
  rawText              String?
  locale               String                     @default("en")
  promptVersion        String?
  quantity             Decimal?                   @db.Decimal(10, 3)
  unit                 String?
  category             String?
  emoji                String?
  colorToken           String?
  storageLocation      PantryStorageLocation      @default(PANTRY)
  expiresAt            DateTime?
  classificationStatus PantryClassificationStatus @default(UNCLASSIFIED)
  classification       Json                       @default("{}")
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiUsage AIUsage[]

  @@index([userId, updatedAt])
  @@index([userId, canonicalName])
  @@index([userId, expiresAt])
  @@index([userId, category])
  @@map("pantry_items")
}

model ShoppingListItem {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @db.Uuid
  name                  String
  canonicalName         String?
  quantity              Decimal? @db.Decimal(10, 3)
  unit                  String?
  category              String?
  emoji                 String?
  done                  Boolean  @default(false)
  fromRecipeCount       Int      @default(0)
  source                String   @default("MANUAL") // MANUAL | RECIPE | MEAL_PLAN
  sourceRecipeId        String?  @db.Uuid
  sourceMealPlanEntryId String?  @db.Uuid
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, done, updatedAt])
  @@index([userId, canonicalName])
  @@map("shopping_list_items")
}

model MealPlanEntry {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  date      DateTime      @db.Date
  slot      MealSlot
  kind      MealEntryKind
  recipeId  String?       @db.Uuid
  note      String?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date, slot, sortOrder])
  @@map("meal_plan_entries")
}

model NutritionSnapshot {
  id                    String          @id @default(uuid()) @db.Uuid
  recipeRevisionId      String          @db.Uuid
  status                NutritionStatus @default(NOT_REQUESTED)
  servings              Decimal?        @db.Decimal(10, 3)
  wholeRecipe           Json?
  perServing            Json?
  per100g               Json?
  coveragePercent       Decimal?        @db.Decimal(5, 2)
  unmatchedIngredients  Json?
  provider              String?
  calculatedAt          DateTime?
  totalGrams            Decimal?        @db.Decimal(12, 3)
  failureReason         String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  recipeRevision RecipeRevision       @relation(fields: [recipeRevisionId], references: [id], onDelete: Cascade)
  foodMatches    NutritionFoodMatch[]
  aiUsage        AIUsage[]

  @@index([recipeRevisionId, createdAt])
  @@index([status, updatedAt])
  @@map("nutrition_snapshots")
}

model NutritionFoodMatch {
  id                   String   @id @default(uuid()) @db.Uuid
  nutritionSnapshotId  String   @db.Uuid
  revisionIngredientId String?  @db.Uuid
  query                String
  matchedFoodId        String?
  matchedFoodName      String?
  confidence           Float?
  grams                Decimal? @db.Decimal(12, 3)
  nutrients            Json?
  createdAt            DateTime @default(now())

  nutritionSnapshot  NutritionSnapshot         @relation(fields: [nutritionSnapshotId], references: [id], onDelete: Cascade)
  revisionIngredient RecipeRevisionIngredient? @relation(fields: [revisionIngredientId], references: [id], onDelete: SetNull)

  @@index([nutritionSnapshotId])
  @@index([revisionIngredientId])
  @@map("nutrition_food_matches")
}

/// Normalised search query → FDC id. Survives process restarts so repeat recipes skip USDA search.
model NutritionQueryCache {
  id          String   @id @default(uuid()) @db.Uuid
  query       String
  fdcId       String?
  matchedName String?
  dataType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([query])
  @@map("nutrition_query_cache")
}

/// Nutrients and portions keyed by FDC id (per 100 g).
model NutritionFoodCache {
  fdcId     String   @id
  foodName  String
  dataType  String
  nutrients Json
  portions  Json
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("nutrition_food_cache")
}

// --- Media & AI artifacts ----------------------------------------------------

model MediaAsset {
  id              String    @id @default(uuid()) @db.Uuid
  jobId           String    @db.Uuid
  assetType       AssetType
  storageKey      String
  mimeType        String
  sizeBytes       BigInt    @default(0)
  durationSeconds Int?
  metadata        Json      @default("{}")
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  job            ExtractionJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  transcript     Transcript?
  ocrResults     OCRResult[]
  visionAnalyses VisionAnalysis[]

  @@index([jobId])
  @@map("media_assets")
}

model Transcript {
  id           String   @id @default(uuid()) @db.Uuid
  mediaAssetId String   @unique @db.Uuid
  language     String
  fullText     String
  provider     Json     @default("{}")
  createdAt    DateTime @default(now())

  mediaAsset MediaAsset          @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  segments   TranscriptSegment[]

  @@map("transcripts")
}

model TranscriptSegment {
  id           String @id @default(uuid()) @db.Uuid
  transcriptId String @db.Uuid
  startSeconds Float
  endSeconds   Float
  text         String
  confidence   Float  @default(0)

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@map("transcript_segments")
}

model OCRResult {
  id               String @id @default(uuid()) @db.Uuid
  mediaAssetId     String @db.Uuid
  text             String
  timestampSeconds Float?
  confidence       Float  @default(0)
  boundingBoxes    Json   @default("[]")
  provider         Json   @default("{}")

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@map("ocr_results")
}

model VisionAnalysis {
  id               String @id @default(uuid()) @db.Uuid
  mediaAssetId     String @db.Uuid
  observations     Json   @default("[]")
  timestampSeconds Float?
  provider         Json   @default("{}")

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@map("vision_analyses")
}

model ExtractionEvidence {
  id               String         @id @default(uuid()) @db.Uuid
  jobId            String         @db.Uuid
  evidenceType     EvidenceType
  value            String
  source           EvidenceSource
  timestampSeconds Float?
  confidence       Float          @default(0)
  metadata         Json           @default("{}")

  job      ExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recipe   Recipe?       @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeId String?       @db.Uuid

  @@index([jobId])
  @@map("extraction_evidence")
}

model AIUsage {
  id                  String   @id @default(uuid()) @db.Uuid
  jobId               String?  @db.Uuid
  userId              String?  @db.Uuid
  recipeRevisionId    String?  @db.Uuid
  pantryItemId        String?  @db.Uuid
  nutritionSnapshotId String?  @db.Uuid
  provider            String
  model               String
  operation           String
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  estimatedCostUsd    Decimal  @default(0) @db.Decimal(10, 6)
  durationMs          Int      @default(0)
  createdAt           DateTime @default(now())

  job               ExtractionJob?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeRevision    RecipeRevision?    @relation(fields: [recipeRevisionId], references: [id], onDelete: SetNull)
  pantryItem        PantryItem?        @relation(fields: [pantryItemId], references: [id], onDelete: SetNull)
  nutritionSnapshot NutritionSnapshot? @relation(fields: [nutritionSnapshotId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([userId, createdAt])
  @@index([recipeRevisionId])
  @@index([pantryItemId])
  @@index([nutritionSnapshotId])
  @@map("ai_usage")
}
