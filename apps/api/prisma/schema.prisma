generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums -------------------------------------------------------------------

enum SourceType {
  INSTAGRAM
  YOUTUBE
  FACEBOOK
  TIKTOK
  GENERIC_WEB
}

enum JobStatus {
  QUEUED
  ACQUIRING_CONTENT
  CONTENT_ACQUIRED
  PROCESSING_MEDIA
  TRANSCRIBING
  ANALYZING_FRAMES
  RUNNING_OCR
  EXTRACTING_RECIPE
  NORMALIZING_RECIPE
  VALIDATING_RECIPE
  COMPLETED
  FAILED
  CANCELLED
}

enum PipelineStage {
  ACQUIRING_CONTENT
  PROCESSING_MEDIA
  TRANSCRIBING
  ANALYZING_FRAMES
  RUNNING_OCR
  EXTRACTING_RECIPE
  NORMALIZING_RECIPE
  VALIDATING_RECIPE
}

enum StageStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum AssetType {
  VIDEO
  AUDIO
  IMAGE
  THUMBNAIL
  FRAME
}

enum EvidenceType {
  CAPTION
  DESCRIPTION
  TRANSCRIPT
  OCR
  VISION
  METADATA
}

enum EvidenceSource {
  CAPTION
  TRANSCRIPT
  OCR
  VISION
  METADATA
  LLM
}

enum CookSessionStatus {
  IN_PROGRESS
  COMPLETED
  STOPPED
}

// --- Source & jobs -----------------------------------------------------------

model RecipeSource {
  id            String     @id @default(uuid()) @db.Uuid
  sourceType    SourceType
  originalUrl   String
  normalizedUrl String
  urlHash       String     @unique
  metadata      Json       @default("{}")
  createdAt     DateTime   @default(now())

  jobs   ExtractionJob[]
  recipe Recipe?

  @@index([sourceType, createdAt])
  @@map("recipe_sources")
}

model ExtractionJob {
  id             String    @id @default(uuid()) @db.Uuid
  recipeSourceId String    @db.Uuid
  recipeId       String?   @unique @db.Uuid
  status         JobStatus @default(QUEUED)
  progress       Int       @default(0)
  currentStage   String?
  sourceLanguage String?
  outputLanguage String    @default("en")
  options        Json      @default("{}")
  error          Json?
  retryCount     Int       @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  recipeSource RecipeSource      @relation(fields: [recipeSourceId], references: [id], onDelete: Cascade)
  recipe       Recipe?           @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  stages       ExtractionStage[]
  mediaAssets  MediaAsset[]
  evidence     ExtractionEvidence[]
  aiUsage      AIUsage[]
  providerUsage ProviderUsage[]

  @@index([status])
  @@index([createdAt])
  @@map("extraction_jobs")
}

model ExtractionStage {
  id          String        @id @default(uuid()) @db.Uuid
  jobId       String        @db.Uuid
  stage       PipelineStage
  status      StageStatus   @default(PENDING)
  progress    Int           @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  error       Json?
  attempt     Int           @default(1)

  job ExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("extraction_stages")
}

// --- Recipes -----------------------------------------------------------------

model Recipe {
  id               String   @id @default(uuid()) @db.Uuid
  title            String
  description      String?
  servings         Int?
  prepTimeMinutes  Int?
  cookTimeMinutes  Int?
  totalTimeMinutes Int?
  calories         Int?
  cuisine          String?
  /// Macro breakdown, e.g. { proteinGrams, carbsGrams, fatGrams }
  nutrition        Json?
  sourceLanguage   String?
  confidence       Float    @default(0)
  warnings         Json     @default("[]")
  promptVersion    String?
  rawExtraction    Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recipeSourceId String       @unique @db.Uuid
  recipeSource   RecipeSource @relation(fields: [recipeSourceId], references: [id], onDelete: Cascade)
  job            ExtractionJob?
  ingredients    RecipeIngredient[]
  steps          RecipeStep[]
  evidence       ExtractionEvidence[]
  cookSessions   CookSession[]

  @@index([createdAt])
  @@map("recipes")
}

model CookSession {
  id                   String            @id @default(uuid()) @db.Uuid
  recipeId             String            @db.Uuid
  status               CookSessionStatus @default(IN_PROGRESS)
  currentStepIndex     Int               @default(0)
  currentStepEnteredAt DateTime          @default(now())
  startedAt            DateTime          @default(now())
  finishedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  recipe    Recipe                @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  stepStats CookSessionStepStat[]

  @@index([status, updatedAt])
  @@index([recipeId])
  @@map("cook_sessions")
}

model CookSessionStepStat {
  id             String   @id @default(uuid()) @db.Uuid
  sessionId      String   @db.Uuid
  stepIndex      Int
  visitCount     Int      @default(0)
  durationMs     Int      @default(0)
  firstEnteredAt DateTime @default(now())
  lastEnteredAt  DateTime @default(now())

  session CookSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, stepIndex])
  @@index([sessionId])
  @@map("cook_session_step_stats")
}

model RecipeIngredient {
  id             String   @id @default(uuid()) @db.Uuid
  recipeId       String   @db.Uuid
  name           String
  canonicalName  String?
  quantity       Decimal? @db.Decimal(10, 3)
  unit           String?
  preparation    String?
  optional       Boolean  @default(false)
  /// Grocery grouping: Produce | Meat | Dairy | Pantry | Spices | Frozen
  category       String   @default("Pantry")
  confidence     Float    @default(0)
  provenance     Json     @default("{}")
  warnings       Json     @default("[]")
  sortOrder      Int      @default(0)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([canonicalName])
  @@map("recipe_ingredients")
}

model RecipeStep {
  id              String  @id @default(uuid()) @db.Uuid
  recipeId        String  @db.Uuid
  stepOrder       Int
  instruction     String
  durationMinutes Int?
  temperature     String?
  /// Cooking stage: PREP | COOK | FINISH | SERVE
  stage           String  @default("COOK")
  confidence      Float   @default(0)
  provenance      Json    @default("{}")
  warnings        Json    @default("[]")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("recipe_steps")
}

// --- Media & AI artifacts ----------------------------------------------------

model MediaAsset {
  id              String    @id @default(uuid()) @db.Uuid
  jobId           String    @db.Uuid
  assetType       AssetType
  storageKey      String
  mimeType        String
  sizeBytes       BigInt    @default(0)
  durationSeconds Int?
  metadata        Json      @default("{}")
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  job            ExtractionJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  transcript     Transcript?
  ocrResults     OCRResult[]
  visionAnalyses VisionAnalysis[]

  @@index([jobId])
  @@map("media_assets")
}

model Transcript {
  id           String   @id @default(uuid()) @db.Uuid
  mediaAssetId String   @unique @db.Uuid
  language     String
  fullText     String
  provider     Json     @default("{}")
  createdAt    DateTime @default(now())

  mediaAsset MediaAsset          @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  segments   TranscriptSegment[]

  @@map("transcripts")
}

model TranscriptSegment {
  id           String @id @default(uuid()) @db.Uuid
  transcriptId String @db.Uuid
  startSeconds Float
  endSeconds   Float
  text         String
  confidence   Float  @default(0)

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@map("transcript_segments")
}

model OCRResult {
  id               String @id @default(uuid()) @db.Uuid
  mediaAssetId     String @db.Uuid
  text             String
  timestampSeconds Float?
  confidence       Float  @default(0)
  boundingBoxes    Json   @default("[]")
  provider         Json   @default("{}")

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@map("ocr_results")
}

model VisionAnalysis {
  id               String @id @default(uuid()) @db.Uuid
  mediaAssetId     String @db.Uuid
  observations     Json   @default("[]")
  timestampSeconds Float?
  provider         Json   @default("{}")

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@map("vision_analyses")
}

model ExtractionEvidence {
  id               String         @id @default(uuid()) @db.Uuid
  jobId            String         @db.Uuid
  evidenceType     EvidenceType
  value            String
  source           EvidenceSource
  timestampSeconds Float?
  confidence       Float          @default(0)
  metadata         Json           @default("{}")

  job    ExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recipe Recipe?       @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeId String?     @db.Uuid

  @@index([jobId])
  @@map("extraction_evidence")
}

model AIUsage {
  id               String   @id @default(uuid()) @db.Uuid
  jobId            String   @db.Uuid
  provider         String
  model            String
  operation        String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  estimatedCostUsd Decimal  @default(0) @db.Decimal(10, 6)
  durationMs       Int      @default(0)
  createdAt        DateTime @default(now())

  job ExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("ai_usage")
}

model ProviderUsage {
  id               String   @id @default(uuid()) @db.Uuid
  jobId            String   @db.Uuid
  provider         String
  operation        String
  sourceType       String
  units            Int      @default(1)
  estimatedCostUsd Decimal  @default(0) @db.Decimal(10, 6)
  durationMs       Int      @default(0)
  createdAt        DateTime @default(now())

  job ExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("provider_usage")
}
