# Copy to `.env` for local development: `cp .env.example .env`
#
# `.env` is git-ignored and must never contain production secrets. In AWS, these values come
# from the ECS task definition (plain values) and Secrets Manager / SSM Parameter Store
# (sensitive values) — not from a file baked into the image.
#
# Every variable below is optional: the defaults shown are what the application uses when the
# variable is unset. All of them are validated at startup by src/config/env.ts, and the process
# exits immediately if any value is invalid.

# --- Runtime -----------------------------------------------------------------------------------
# development | test | production
NODE_ENV=development

# 0.0.0.0 is required inside a container so the port is reachable from outside it.
HOST=0.0.0.0
PORT=3000

# Identifies the service in every log line. Use `worker` for the worker process.
SERVICE_NAME=api
SERVICE_VERSION=0.1.0

# --- Logging -----------------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
# `info` logs one line per request plus pipeline/worker steps; use `debug` when diagnosing locally.
LOG_LEVEL=info
# Daily files: logs/<SERVICE_NAME>.YYYY-MM-DD.log (git-ignored). Empty disables file logging.
LOG_DIR=./logs

# --- API ---------------------------------------------------------------------------------------
# Version prefix for all application routes. `/health` is additionally served unprefixed.
API_PREFIX=/api/v1

# Serves Swagger UI at /docs. Defaults to true outside production, false in production.
# ENABLE_DOCS=true

# --- CORS --------------------------------------------------------------------------------------
# Comma-separated allow-list. Never a wildcard. Empty (the default) rejects all cross-origin
# browser requests, which is correct for a mobile-only API: React Native's fetch is not subject
# to CORS. Add origins for web clients, e.g. Expo web and Expo dev tools:
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Security ----------------------------------------------------------------------------------
# Set to true ONLY when running behind a trusted proxy (an ALB). It makes the app read the client
# IP from X-Forwarded-For, which rate limiting depends on. Leaving it true without a proxy in
# front would let clients spoof their address.
TRUST_PROXY=false

# Maximum accepted request body, in bytes (default 1 MiB).
BODY_LIMIT_BYTES=1048576

# Maximum length of a single URL path parameter.
MAX_PARAM_LENGTH=128

# Requests allowed per window, per client IP, per task. See src/app/plugins/rate-limit.ts for
# how to share the counters across tasks with ElastiCache.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Timeouts ----------------------------------------------------------------------------------
# Abort requests that exceed this duration (0 disables).
REQUEST_TIMEOUT_MS=30000

# Must stay ABOVE the ALB idle timeout (60s by default), otherwise the ALB may reuse a connection
# the app has just closed and return a 502 to the client.
KEEP_ALIVE_TIMEOUT_MS=72000

# Time allowed for in-flight requests to finish after SIGTERM. Keep it BELOW the ECS
# `stopTimeout` so the platform never has to SIGKILL the container.
SHUTDOWN_TIMEOUT_MS=10000

# --- Database ----------------------------------------------------------------------------------
# PostgreSQL connection string. Matches docker-compose defaults.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recipe_api
# Integration tests must use a separate database. Never point this at recipe_api.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recipe_api_test

# --- Redis / queue -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Storage -----------------------------------------------------------------------------------
# local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# Required when STORAGE_PROVIDER=s3
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ENDPOINT=

# --- AI (Phase 7+) -----------------------------------------------------------------------------
# OPENAI_API_KEY=
# Required for live extraction, transcription, vision, and pantry organization of unknown text.
# Tests and the fake pipeline never call OpenAI. Leave unset locally to keep pantry on
# dictionary + fallback only.
AI_DEFAULT_MODEL=gpt-4o-mini
AI_WHISPER_MODEL=whisper-1
# Vision + OCR. gpt-4o-mini bills a high-detail video frame at ~37k tokens (it hits a 200k TPM
# limit after ~5 frames); gpt-4.1-mini bills the same frame at ~2.5k.
AI_VISION_MODEL=gpt-4.1-mini
# OpenAI SDK retries for 429 / 5xx / timeouts (honours Retry-After).
AI_MAX_RETRIES=5
# Pantry / ingredient organization policy (change models here — never in code):
#   1. Deterministic dictionary + Redis/memory classification cache first.
#   2. One compact batch to AI_INGREDIENT_MODEL (gpt-5-nano). Never GPT-5.6.
#   3. Compatibility fallback: AI_INGREDIENT_FALLBACK_MODEL (gpt-4.1-nano).
#   4. Quality escalation: at most AI_INGREDIENT_MAX_ESCALATIONS items to gpt-4o-mini.
# Token/item budgets below are enforced per organize request.
AI_INGREDIENT_MODEL=gpt-5-nano
AI_INGREDIENT_FALLBACK_MODEL=gpt-4.1-nano
AI_INGREDIENT_ESCALATION_MODEL=gpt-4o-mini
AI_INGREDIENT_REASONING_EFFORT=none
AI_INGREDIENT_MAX_OUTPUT_TOKENS=1024
AI_INGREDIENT_MAX_INPUT_TOKENS=2500
AI_INGREDIENT_MAX_ITEMS=40
AI_INGREDIENT_MAX_ESCALATIONS=5
AI_INGREDIENT_LOW_CONFIDENCE=0.55
AI_INGREDIENT_PROMPT_VERSION=ingredient-enrichment-v1

# --- Sentry (optional) -------------------------------------------------------------------------
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Extraction pipeline -----------------------------------------------------------------------
EXTRACTION_MAX_RETRIES=5
EXTRACTION_BACKOFF_MS=1000
EXTRACTION_QUEUE_CONCURRENCY=2
# Caps how many extract jobs a client can start per window. Job status polling is not included.
EXTRACTION_EXTRACT_RATE_LIMIT_MAX=10
EXTRACTION_EXTRACT_RATE_LIMIT_WINDOW_MS=60000
MAX_VIDEO_DURATION_SECONDS=600
MEDIA_RETENTION_HOURS=72
# Frame sampling: minimum interval (seconds, may be fractional); widened so MAX_FRAMES spans the video.
FRAME_INTERVAL_SECONDS=1
MAX_FRAMES=150
# Keep a frame when >= this fraction of pixels changed vs the last kept frame (text overlay changes count).
FRAME_DEDUPE_MIN_CHANGED_RATIO=0.002
# AI caps per job (cost levers). OCR frames/vision images are sampled evenly across the timeline.
OCR_MAX_FRAMES=24
VISION_MAX_IMAGES=6
MEDIA_AI_CONCURRENCY=4
# Carousel / image posts: slides OCR'd and carousel videos processed per post.
MAX_POST_IMAGES=20
MAX_POST_VIDEOS=3
MAX_MEDIA_DOWNLOAD_BYTES=209715200
# Prompt budget (characters) for on-screen text + vision, and for the transcript.
EVIDENCE_MEDIA_MAX_CHARS=16000
EVIDENCE_TRANSCRIPT_MAX_CHARS=20000
# Use YouTube captions (manual, else auto) instead of Whisper when yt-dlp exposes them.
YOUTUBE_PREFER_CAPTIONS=true

# --- External content providers (Phase 5+) -----------------------------------------------------
# APIFY_API_TOKEN=
# When a recipe site blocks the direct fetch (e.g. AllRecipes answers 402), re-fetch it through
# Apify's rag-web-browser (headless Chrome + proxy, ~15-35 s, billed per page). Needs APIFY_API_TOKEN.
WEB_BLOCKED_FALLBACK=true
# Optional Instagram Graph oEmbed (preview only — never used for extraction). App token is `{id}|{secret}`.
# META_APP_ID=
# META_APP_SECRET=
# Path to the yt-dlp binary used for YouTube preview and extraction. Must be on PATH in Docker.
# YTDLP_PATH=yt-dlp

# --- Firebase Authentication ---------------------------------------------------
# Never commit a service account JSON file. Put FIREBASE_PRIVATE_KEY in the environment
# or a secret store. Use separate Firebase projects for dev and prod, and list only those
# environments' domains as authorized domains in the Firebase console.
# App Check: ship with APP_CHECK_ENFORCE=false (monitor), then turn it on once clients send
# X-Firebase-AppCheck. Phone routes are rate limited; do not send SMS from this API and do
# not store OTP codes. The client completes phone auth with Firebase.
# AUTH_REQUIRED=false keeps the implicit profile when Authorization is absent so existing
# clients keep working. A present bearer token is always verified.
AUTH_REQUIRED=false
APP_CHECK_ENFORCE=false
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_AUTH_EMULATOR_HOST=
# Dev/test only. Refused as the production verifier when Firebase credentials are missing.
# AUTH_HMAC_SECRET=
# Extra reserved usernames, comma-separated. Built-in reserves (admin, support, …) always apply.
AUTH_RESERVED_USERNAMES=
AUTH_RECENT_LOGIN_SECONDS=300
AUTH_PHONE_RESEND_SECONDS=60
AUTH_PHONE_MAX_ATTEMPTS=5

# --- Workers -------------------------------------------------------------------
# Run two processes: the HTTP API (`npx nx dev api`) and the worker
# (`npx nx run api:dev:worker`). The worker consumes extraction-jobs from
# Redis/BullMQ. GET /api/v1/ops/summary reports in-flight
# counts from Postgres (no admin UI). Firebase auth lives in src/modules/auth;
# /health stays public.
