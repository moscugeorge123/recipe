# Copy to `.env` for local development: `cp .env.example .env`
#
# `.env` is git-ignored and must never contain production secrets. In AWS, these values come
# from the ECS task definition (plain values) and Secrets Manager / SSM Parameter Store
# (sensitive values) — not from a file baked into the image.
#
# Every variable below is optional: the defaults shown are what the application uses when the
# variable is unset. All of them are validated at startup by src/config/env.ts, and the process
# exits immediately if any value is invalid.

# --- Runtime -----------------------------------------------------------------------------------
# development | test | production
NODE_ENV=development

# 0.0.0.0 is required inside a container so the port is reachable from outside it.
HOST=0.0.0.0
PORT=3000

# Identifies the service in every log line. Use `worker` for the worker process.
SERVICE_NAME=api
SERVICE_VERSION=0.1.0

# --- Logging -----------------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
# `info` logs one line per request plus pipeline/worker steps; use `debug` when diagnosing locally.
LOG_LEVEL=info
# Daily files: logs/<SERVICE_NAME>.YYYY-MM-DD.log (git-ignored). Empty disables file logging.
LOG_DIR=./logs

# --- API ---------------------------------------------------------------------------------------
# Version prefix for all application routes. `/health` is additionally served unprefixed.
API_PREFIX=/api/v1

# Serves Swagger UI at /docs. Defaults to true outside production, false in production.
# ENABLE_DOCS=true

# --- CORS --------------------------------------------------------------------------------------
# Comma-separated allow-list. Never a wildcard. Empty (the default) rejects all cross-origin
# browser requests, which is correct for a mobile-only API: React Native's fetch is not subject
# to CORS. Add origins for web clients, e.g. Expo web, Expo dev tools, and the
# import dashboard when it is not using the Vite /api proxy:
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:5173

# --- Security ----------------------------------------------------------------------------------
# Set to true ONLY when running behind a trusted proxy (an ALB). It makes the app read the client
# IP from X-Forwarded-For, which rate limiting depends on. Leaving it true without a proxy in
# front would let clients spoof their address.
TRUST_PROXY=false

# Maximum accepted request body, in bytes (default 1 MiB).
BODY_LIMIT_BYTES=1048576

# Maximum length of a single URL path parameter.
MAX_PARAM_LENGTH=128

# Requests allowed per window, per client IP, per task. See src/app/plugins/rate-limit.ts for
# how to share the counters across tasks with ElastiCache.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Timeouts ----------------------------------------------------------------------------------
# Abort requests that exceed this duration (0 disables).
REQUEST_TIMEOUT_MS=30000

# Must stay ABOVE the ALB idle timeout (60s by default), otherwise the ALB may reuse a connection
# the app has just closed and return a 502 to the client.
KEEP_ALIVE_TIMEOUT_MS=72000

# Time allowed for in-flight requests to finish after SIGTERM. Keep it BELOW the ECS
# `stopTimeout` so the platform never has to SIGKILL the container.
SHUTDOWN_TIMEOUT_MS=10000

# --- Database ----------------------------------------------------------------------------------
# PostgreSQL connection string. Matches docker-compose defaults.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recipe_api
# Integration tests must use a separate database. Never point this at recipe_api.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recipe_api_test

# --- Redis / queue -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Storage -----------------------------------------------------------------------------------
# local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# Required when STORAGE_PROVIDER=s3
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ENDPOINT=

# --- AI (Phase 7+) -----------------------------------------------------------------------------
# OPENAI_API_KEY=
AI_DEFAULT_MODEL=gpt-4o-mini
AI_WHISPER_MODEL=whisper-1
AI_VISION_MODEL=gpt-4o-mini

# --- Sentry (optional) -------------------------------------------------------------------------
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Extraction pipeline -----------------------------------------------------------------------
EXTRACTION_MAX_RETRIES=5
EXTRACTION_BACKOFF_MS=1000
EXTRACTION_QUEUE_CONCURRENCY=2
# Caps how many extract jobs a client can start per window. Job status polling is not included.
EXTRACTION_EXTRACT_RATE_LIMIT_MAX=10
EXTRACTION_EXTRACT_RATE_LIMIT_WINDOW_MS=60000
MAX_VIDEO_DURATION_SECONDS=600
MEDIA_RETENTION_HOURS=72

# --- External content providers (Phase 5+) -----------------------------------------------------
# APIFY_API_TOKEN=
# Optional Instagram Graph oEmbed (preview only — never used for extraction). App token is `{id}|{secret}`.
# META_APP_ID=
# META_APP_SECRET=
# Path to the yt-dlp binary used for YouTube preview and extraction. Must be on PATH in Docker.
# YTDLP_PATH=yt-dlp
