rules_version = '2';

// Profile pictures only: users/{uid}/avatar.jpg, written by
// apps/mobile/src/features/auth/avatar-service.ts. Owner-only write (JPEG, at
// most 1 MiB). The app displays the picture through the file's download token
// (stored in the user's photoURL), so rules only need to cover the owner.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/avatar.jpg {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
