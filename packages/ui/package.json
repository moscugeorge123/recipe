  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.81"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "typescript": "^5.9.3"
  }
}
