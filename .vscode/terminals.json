{
  "autorun": false,
  "terminals": [
    {
      "name": "Mobile",
      "focus": true,
      "commands": [
        "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kill-dev-servers.ps1",
        "npm run dev:mobile"
      ]
    },
    {
      "name": "API",
      "commands": [
        "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kill-dev-servers.ps1",
        "npm run dev:api"
      ]
    },
    {
      "name": "Dashboard",
      "commands": [
        "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kill-dev-servers.ps1",
        "npm run dev:dashboard"
      ]
    },
    {
      "name": "Dashboard Fixtures",
      "commands": [
        "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kill-dev-servers.ps1",
        "npm run dev:dashboard:fixtures"
      ]
    },
    {
      "name": "Worker",
      "commands": [
        "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kill-dev-servers.ps1",
        "npm run dev:worker"
      ]
    }
  ]
}
